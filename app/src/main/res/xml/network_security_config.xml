<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de tráfico en texto plano:
  Solo se permite HTTP sin cifrar contra el bucle local (127.0.0.1 / localhost)
  donde escucha el motor embebido de deepseek-harness (puerto 3080 por defecto).
  Todo el tráfico saliente a Internet exige TLS/HTTPS.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
