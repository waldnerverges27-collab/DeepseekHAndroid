# Gradle & Android build artifacts
.gradle/
**/build/
local.properties
*.iml
.idea/
.cxx/
captures/
.externalNativeBuild/
output-metadata.json

# Keystores & secrets
*.jks
*.keystore
keystore.properties
.env

# Large runtime / native artifacts generated by scripts/
app/src/main/assets/rootfs.tar.xz
app/src/main/assets/rootfs.tar.xz.sha256
app/src/main/assets/proot/
app/src/main/jniLibs/**/*.so
!app/src/main/jniLibs/**/.gitkeep

# Temporary staging directories
.rootfs-stage/
.proot-stage/
*.apk
*.aab
